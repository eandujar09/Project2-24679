# Environment-variable alternative to .env.local.json (the launcher reads JSON).
MECHANICAL_TRANSPORT=opencode
# Login belongs in the ignored .env.opencode.json, not here.
MECHANICAL_REMOTE_DIR=C:/Users/YOUR_USER/Project2-worker
MECHANICAL_REMOTE_PYTHON=C:/Users/YOUR_USER/Project2-worker/.venv-ansys/Scripts/python.exe
MECHANICAL_REMOTE_PLATFORM=windows

# Read-only Fluent MCP discovery/help/validation inside the Studio web chatbot.
# Keep MCP's newer PyFluent separate from the actual simulation worker Python.
FLUENT_MCP_PYTHON=C:/path/to/.venv-fluent-mcp/Scripts/python.exe
# Optional worker-matched offline API index; recommended when versions differ.
FLUENT_MCP_API_OBJECTS_PATH=C:/path/to/.venv-fluent/Lib/site-packages/ansys/fluent/core/generated/api_tree/api_objects.json

# Model already configured on the OpenCode server (no API key in this file).
CAD_CHAT_PROVIDER_ID=openai
CAD_CHAT_MODEL=gpt-6.1-sol
